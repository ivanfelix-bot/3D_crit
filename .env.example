# =============================================================================
# 3D Crit – Variabili d'ambiente
# Copia questo file in .env.local (in locale) oppure inserisci i valori su
# Vercel → Project → Settings → Environment Variables.
# NON inserire mai i valori reali in questo file né su GitHub.
# =============================================================================

# --- FASE 1 (obbligatorie) ---------------------------------------------------
# Supabase → Project Settings → API (o "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pubblico del sito (facoltativo su Vercel: se vuoto usa il dominio .vercel.app)
# Quando colleghi il tuo dominio: NEXT_PUBLIC_SITE_URL=https://www.3dcrit.it
NEXT_PUBLIC_SITE_URL=

# --- FASE 2: pagamenti (lasciare vuote finché non hai la partita IVA) --------
# Accende il checkout senza passare dall'admin (true/false)
PAYMENTS_ENABLED=false
# Supabase → Project Settings → API → service_role (SEGRETA, solo server)
SUPABASE_SERVICE_ROLE_KEY=
# Stripe → Developers → API keys / Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# PayPal → developer.paypal.com → Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "live" per i pagamenti reali, "sandbox" per le prove
PAYPAL_ENV=sandbox
# Costo di spedizione fisso in centesimi (es. 500 = 5,00 €)
SHIPPING_FLAT_CENTS=0
